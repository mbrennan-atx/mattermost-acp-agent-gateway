# Fill in private connection values before starting the gateway.
MATTERMOST_DOTENV=none
MATTERMOST_URL=https://mattermost.example.com
MATTERMOST_TOKEN_FILE=/absolute/private/path/mattermost-token
MATTERMOST_CHANNEL_ID=replace-with-channel-id
MATTERMOST_ALLOW_USER_IDS=replace-with-user-id
MATTERMOST_AUTO_JOIN_CHANNELS=0
# Select an installed adapter and its executable.
HARNESS=codex
AGENT_COMMAND=codex-acp
AGENT_CWD=/absolute/path/to/workspace
# Explicitly choose the tool approval policy for your deployment.
AGENT_ALWAYS_APPROVE=0
MATTERMOST_SLASH_PORT=0
MATTERMOST_ACP_DB=/absolute/private/path/state/threads.db
