#!/usr/bin/env python3
"""Switch an assistant using external harness profiles and inventory.

  scripts/set-harness assistant-a claude --dry-run
  scripts/set-harness assistant-b codex --no-restart
  scripts/set-harness --list

Backups are stored beside the selected env file under .env-backups.
Existing thread titles remain; sessions and models do not cross harnesses.
"""

from __future__ import annotations

import argparse
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from mattermost_acp import harness_switch as hs  # noqa: E402


def _list() -> int:
    profiles = hs.load_profiles()
    roster = hs.load_roster()
    print("harnesses: " + ", ".join(f"{p.name} ({p.model})" for p in profiles.values()))
    for agent in roster["agents"]:
        env_path = hs.deployment.resolve_path(
            str(agent.get("env_file") or ""),
            hs.deployment.document_base(hs.deployment.selected_path("roster"), roster),
        )
        try:
            current = hs.read_env_value(env_path.read_text(encoding="utf-8"), "HARNESS")
        except OSError:
            current = None
        print(f"  {agent['username']:<20} {current or agent.get('harness') or '?'}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("agent", nargs="?", help="roster username, e.g. assistant-a")
    parser.add_argument("harness", nargs="?", help="grok, claude, codex, or cursor")
    parser.add_argument("--model", help="model id (default: the profile's model)")
    parser.add_argument("--list", action="store_true", help="show each agent's harness")
    parser.add_argument("--no-restart", action="store_true", help="only rewrite files")
    parser.add_argument("--force", action="store_true", help="restart even if turns are running")
    parser.add_argument(
        "--wait", type=float, default=900, help="seconds to wait for idle (default 900)"
    )
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    if args.list:
        return _list()
    if not args.agent or not args.harness:
        parser.error("agent and harness are required (or use --list)")

    try:
        plan = hs.apply_switch(args.agent, args.harness, model=args.model, dry_run=args.dry_run)
    except hs.SwitchError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    print(
        f"{plan.username}: {plan.old_harness} -> {plan.new_harness} "
        f"model {plan.model} ({plan.env_path.name}, unit {plan.unit})"
    )
    if args.dry_run:
        print("dry run: nothing written")
        return 0
    print(f"backup: {plan.backup_path}")
    if args.no_restart:
        print(f"not restarted; run: systemctl --user restart {plan.unit}")
        return 0

    if not args.force:
        busy = hs.wait_idle(plan.db_path, timeout_s=args.wait)
        if busy:
            print(
                f"still busy after {args.wait:.0f}s ({len(busy)} turn(s)); files are "
                f"updated. Restart later or rerun with --force.",
                file=sys.stderr,
            )
            return 3
    hs.restart_unit(plan.unit)
    time.sleep(5)
    if not hs.unit_active(plan.unit):
        print(f"error: {plan.unit} is not active; restore with the backup above", file=sys.stderr)
        return 4
    print(f"restarted {plan.unit}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
