# Render with scripts/install-systemd.sh from the checkout root.
[Unit]
Description=Mattermost ACP gateway
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__ENV_FILE__
ExecStart=__EXECUTABLE__
Restart=always
RestartSec=2
TimeoutStopSec=20
KillMode=mixed
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
